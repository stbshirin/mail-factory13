rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Designated Admin from user request
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'soheltajbhola@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Mail batches submitted by sellers
    match /mail_batches/{batchId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Marketplace items (publicly visible catalogue, admin writes)
    match /marketplace_items/{itemId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Buyer orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Transactions (deposits, withdrawals, ledger)
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Platform settings (buying rates, bKash/Nagad numbers, notice)
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Reviews & ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }
  }
}
